# Aplicação
NODE_ENV=development
PORT=5000
JWT_SECRET=troque-por-uma-chave-longa-com-pelo-menos-32-caracteres

# --- Banco ---
# Opção 1 (recomendado no Windows sem Docker): Postgres embutido
DATABASE_URL=pglite

# Opção 2: Docker Compose deste repositório
# DATABASE_URL=postgresql://encaixe:encaixe_local@localhost:5432/encaixe

# Opção 3: PostgreSQL já instalado / produção
# DATABASE_URL=postgresql://usuario:senha@127.0.0.1:5432/encaixe
