# Aplicação
NODE_ENV=development
PORT=5000
JWT_SECRET=troque-por-uma-chave-longa-com-pelo-menos-32-caracteres

# Painel mestre (/master) — cria e gerencia várias contas de negócios
# Em produção, defina e-mail e senha fortes (obrigatório).
MASTER_EMAIL=master@encaixe.local
MASTER_PASSWORD=Master@1234

# WhatsApp — local: console + simulador no /admin
WHATSAPP_PROVIDER=console

# Produção (script: sudo bash scripts/install-whatsapp.sh)
# Porta 8081 para não conflitar com Brasa (:8080) na mesma VPS
# WHATSAPP_PROVIDER=evolution
# EVOLUTION_API_URL=http://127.0.0.1:8081
# EVOLUTION_SERVER_URL=http://127.0.0.1:8081
# EVOLUTION_API_KEY=
# EVOLUTION_DB_PASSWORD=
# EVOLUTION_WEBHOOK_SECRET=
# EVOLUTION_WEBHOOK_HOST=host.docker.internal

# --- Banco ---
# PRODUÇÃO (EC2): sempre PostgreSQL real — NUNCA pglite
# DATABASE_URL=postgresql://encaixe:SENHA@127.0.0.1:5432/encaixe
# NODE_ENV=production

# Local Windows sem Docker/Postgres instalado:
DATABASE_URL=pglite

# Local com Docker Compose deste repositório:
# DATABASE_URL=postgresql://encaixe:encaixe_local@localhost:5432/encaixe
